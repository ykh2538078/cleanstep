# Copy this file to .env and fill in the values before starting a deployment.
# Generate a random secret and keep it stable across all app instances.
# Run `flask --app app init-db` once before starting production workers.
CLEANSTEP_ENV=production
CLEANSTEP_SECRET_KEY=
CLEANSTEP_PUBLIC_URL=https://cleanstep.duckdns.org
CLEANSTEP_DATABASE_PATH=./database.db
CLEANSTEP_UPLOAD_FOLDER=./data/uploads
CLEANSTEP_MODEL_PATH=./models/yolov8n.pt
CLEANSTEP_DISABLE_AI=false
CLEANSTEP_DEBUG=false
# Set true only for a local demo that needs the fixed sample accounts.
CLEANSTEP_DEMO_MODE=false
